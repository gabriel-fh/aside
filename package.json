{
  "name": "aside",
  "version": "0.1.0",
  "description": "Assistente flutuante que acompanha reunioes, aulas e estudo em tempo real",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pdfjs-dist": "^6.5.438"
  },
  "author": "Aside",
  "build": {
    "appId": "app.aside.desktop",
    "productName": "Aside",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "src/main/ocr.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "artifactName": "Aside-${version}-instalador.exe",
      "shortcutName": "Aside"
    },
    "portable": {
      "artifactName": "Aside-${version}-portatil.exe"
    }
  }
}
